#!/usr/bin/env bash
# Capture the real overlay with synthetic files and an isolated Omarchy theme.
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
shell_dir=${OMARCHY_PATH:-/usr/share/omarchy}/shell
work=$(mktemp -d /tmp/files-preview.XXXXXX)
trap 'rm -rf -- "$work"' EXIT
files_demo="$work/demo"
files_user="$work/user"
mkdir -p "$files_demo/Projects" "$files_demo/Documents" "$files_demo/Music"
FILES_DEMO="$files_demo" /usr/bin/python3 - <<'PY'
from pathlib import Path
from PIL import Image, ImageDraw
import os,wave
root=Path(os.environ['FILES_DEMO'])
(root/'Projects/preview.py').write_text('from pathlib import Path\n\n# Find photographs in a folder.\ndef photographs(folder: Path):\n    limit = 12\n    names = sorted(folder.glob("*.jpg"))\n    return names[:limit]\n\nfor photo in photographs(Path("Pictures")):\n    print(f"Found {photo.name}")\n')
(root/'Projects/preview-notes.md').write_text('# File previews\n\nCode, PDFs, images, documents and media.\n')
(root/'Projects/preview-settings.json').write_text('{"preview": true, "font": "system"}\n')
image=Image.new('RGB',(600,400),'#efb875');draw=ImageDraw.Draw(image)
draw.ellipse((420,45,530,155),fill='#fff1ba')
draw.polygon([(0,330),(200,150),(400,330)],fill='#596778')
draw.polygon([(150,400),(400,210),(600,400)],fill='#34475c')
image.save(root/'Documents/preview.pdf',save_all=True,append_images=[Image.new('RGB',(600,400),'#7fbcac')])
image.save(root/'Documents/preview.jpg')
with wave.open(str(root/'Music/preview.wav'),'wb') as f:
    f.setnchannels(1);f.setsampwidth(2);f.setframerate(8000);f.writeframes(b'\0\0'*16000)
for p in root.rglob('*'):
    os.utime(p,(1792404000,1792404000))
os.utime(root/'Projects/preview.py',(1792404060,1792404060))
PY
files_theme="$files_user/.local/state/omarchy/current/next-theme"
mkdir -p "$files_theme" "$files_user/.config/nvim/lua/plugins" "$files_user/.local/share/nvim/lazy"
cp "${OMARCHY_PATH:-/usr/share/omarchy}/themes/ristretto/colors.toml" "$files_theme/colors.toml"
HOME="$files_user" XDG_CONFIG_HOME="$files_user/.config" omarchy-theme-set-templates >/dev/null
cp -r "$files_theme" "$files_theme/../theme"
cp "$files_theme/neovim.lua" "$files_user/.config/nvim/lua/plugins/theme.lua"
# Theme code is already installed, never downloaded by this capture tool.
files_aether="${XDG_DATA_HOME:-$HOME/.local/share}/nvim/lazy/aether"
[[ -d "$files_aether" ]] || { echo 'Install the Omarchy Aether Neovim theme before capturing.' >&2; exit 1; }
ln -s "$files_aether" "$files_user/.local/share/nvim/lazy/aether"
ln -s "$shell_dir/Commons" "$work/Commons"
ln -s "$shell_dir/Ui" "$work/Ui"
ln -s "$repo" "$work/plugin"
cp "$repo/tools/preview/shell.qml" "$work/shell.qml"
mkdir -p "$work/out" "$work/cache"
HOME="$files_user" XDG_CONFIG_HOME="$files_user/.config" XDG_DATA_HOME="$files_user/.local/share" XDG_CACHE_HOME="$work/cache" \
 FILES_PREVIEW_OUT="$work/out" FILES_PREVIEW_HOME="$files_demo" \
 timeout 45 quickshell -p "$work" --no-color >"$work/log" 2>&1 || { cat "$work/log"; exit 1; }
if rg 'TypeError|ReferenceError|SyntaxError|Failed to load configuration' "$work/log"; then exit 1; fi
for name in code pdf audio settings; do
 [[ -s "$work/out/$name.png" ]] || { cat "$work/log"; exit 1; }
 cp "$work/out/$name.png" "$repo/screenshots/preview-$name.png"
done
/usr/bin/python3 "$repo/tools/render-preview-card.py" "$work/out"

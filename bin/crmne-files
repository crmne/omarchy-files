#!/bin/bash

# Index, search, and list files under $HOME for the crmne.files overlay.
#
#   crmne-files [--root DIR] <command>    search DIR instead of $HOME
#   crmne-files index [max-age-seconds]   rebuild the index if missing or older
#   crmne-files search                    fuzzy-match the index, best first
#   crmne-files list                      a folder's children, folders first
#   crmne-files browse                    any absolute folder's children, filtered
#   crmne-files apps                      applications that open a file
#
# The rest comes in the environment, never as arguments: CRMNE_FILES_QUERY
# holds the query, CRMNE_FILES_FOLDER the folder to search or list, and
# CRMNE_FILES_PATH the file apps looks up. Process arguments can be read by
# other users on the same machine, a process's environment only by its owner,
# so none of these reaches the command line of this script or of anything it
# runs.
#
# Paths go in and come out relative to the root ($HOME unless --root), folders with a trailing slash.
# The query is never part of a shell string.

set -uo pipefail
umask 077

# Folders skipped by name anywhere under $HOME, on top of hidden files and
# everything .gitignore already excludes. Edit to taste.
EXCLUDES=(go Android)
if [[ ${CRMNE_FILES_EXCLUDES+x} ]]; then
  EXCLUDES=()
  while IFS= read -r name; do [[ -z $name ]] || EXCLUDES+=("$name"); done <<<"$CRMNE_FILES_EXCLUDES"
fi

# Results returned for one search, and children shown for one folder.
LIMIT=200
LIST_LIMIT=500

root=$HOME
if [[ ${1:-} == --root ]]; then
  root=${2:?--root needs a folder}
  root=${root%/}
  [[ $root == /* && -d $root ]] || { echo "Not a folder: $root" >&2; exit 2; }
  shift 2
fi

# $HOME keeps the plain index; any other root gets one of its own.
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/crmne-files"
index="$cache_dir/index"
[[ $root == "$HOME" ]] || index="$cache_dir/index-$(printf '%s' "$root" | cksum | cut -d' ' -f1)"

# Different exclusion settings must never reuse an incompatible index.
if [[ ${CRMNE_FILES_EXCLUDES+x} ]]; then
  index="$index-excludes-$(printf '%s' "$CRMNE_FILES_EXCLUDES" | sha256sum | cut -c1-16)"
fi

build_index() {
  mkdir -p "$cache_dir" || return 1
  chmod 700 "$cache_dir" || return 1

  # One build at a time: a second caller waits for the first and then finds a
  # fresh index instead of starting its own.
  exec 9>"$index.lock"
  flock 9

  if [[ -n ${1:-} && -s $index ]]; then
    local age=$(($(date +%s) - $(stat --format %Y "$index")))
    if ((age < $1)); then
      echo fresh
      return 0
    fi
  fi

  local excludes=() name
  for name in "${EXCLUDES[@]}"; do excludes+=(--exclude "$name"); done

  local tmp
  tmp=$(mktemp "$cache_dir/index.XXXXXX") || return 1

  # Newest first, so an empty search lists what changed last and fzf breaks
  # score ties in favour of recent files. Names holding a newline are dropped:
  # the index is one path per line. gawk reads each time itself, so no file
  # name lands on a command line the way it would through xargs stat.
  cd "$root" || return 1
  fd --type f --type d "${excludes[@]}" --print0 . |
    gawk -l filefuncs 'BEGIN { RS = "\0"; ORS = "\0" } stat($0, st) == 0 { print st["mtime"] "\t" $0 }' |
    LC_ALL=C sort -z -t $'\t' -k1,1rn |
    gawk 'BEGIN { RS = "\0"; ORS = "\n" }
      index($0, "\n") { next }
      { sub(/^[0-9]+\t(\.\/)?/, ""); if ($0 != "") print }' >"$tmp"

  mv -f "$tmp" "$index"
  echo built
}

# fzf reads the query from its environment, quoted for its option parser.
filter() {
  local query=${CRMNE_FILES_QUERY:-}
  local quoted=${query//\'/\'\\\'\'}
  FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-} --filter='$quoted'" fzf --tiebreak=index
}

search() {
  local query=${CRMNE_FILES_QUERY:-} folder=${CRMNE_FILES_FOLDER:-}
  [[ -s $index ]] || exit 3

  # Nothing typed: the newest files. Folders are left out here because their
  # time changes whenever anything inside them does, which buries real work
  # under build and cache directories.
  if [[ -z $folder && -z $query ]]; then
    grep -v '/$' "$index" | head -n "$LIMIT"
    return 0
  fi

  if [[ -z $folder ]]; then
    filter <"$index" | head -n "$LIMIT"
    return 0
  fi

  # Scoped: match against the part below the folder only, so the folder's own
  # name does not make every entry match, then put the prefix back.
  local -x CRMNE_FILES_PREFIX="${folder%/}/"
  LC_ALL=C gawk 'BEGIN { p = ENVIRON["CRMNE_FILES_PREFIX"] }
    substr($0, 1, length(p)) == p && length($0) > length(p) { print substr($0, length(p) + 1) }' "$index" |
    filter |
    head -n "$LIMIT" |
    gawk '{ print ENVIRON["CRMNE_FILES_PREFIX"] $0 }'
}

# The current folder's children, folders first, then by name, folders with a
# trailing slash. The arguments narrow what fd lists.
children() {
  local name
  fd --max-depth 1 "$@" --print0 . |
    while IFS= read -r -d '' name; do
      name=${name#./}
      [[ $name == *$'\n'* ]] && continue
      name=${name%/}
      if [[ -d $name ]]; then printf '0\t%s/\n' "$name"; else printf '1\t%s\n' "$name"; fi
    done |
    sort -t $'\t' -k1,1n -k2,2f |
    gawk '{ sub(/^[01]\t/, ""); print }'
}

list() {
  local folder=${CRMNE_FILES_FOLDER:-}
  folder=${folder%/}
  local -x CRMNE_FILES_PREFIX="$folder/"
  local dir="$root/$folder"
  [[ -d $dir ]] || exit 4

  # Hidden entries stay out, as they do in the index. Listing . from inside
  # the folder keeps its name off find's command line.
  cd "$dir" || exit 4
  local excludes=() name
  for name in "${EXCLUDES[@]}"; do excludes+=(--exclude "$name"); done
  children --type d --type f "${excludes[@]}" |
    head -n "$LIST_LIMIT" |
    gawk '{ print ENVIRON["CRMNE_FILES_PREFIX"] $0 }'
}

# A typed path such as /etc/ho: everything in CRMNE_FILES_FOLDER, absolute and
# anywhere on the system, whose name matches CRMNE_FILES_QUERY. Nothing is
# excluded, symbolic links are listed so /bin and /lib can be followed, and
# hidden entries appear once the typed name starts with a dot, as in a shell.
# A name typed in full comes first, and a folder typed with nothing after its
# slash leads with itself, so Enter on a pasted path opens what it names.
browse() {
  local folder=${CRMNE_FILES_FOLDER:-} query=${CRMNE_FILES_QUERY:-}
  [[ $folder == /* ]] || exit 4
  local -x CRMNE_FILES_PREFIX="${folder%/}/" CRMNE_FILES_NAME=$query
  cd "$folder" 2>/dev/null || exit 4
  local hidden=()
  [[ $query == .* ]] && hidden=(--hidden)
  if [[ -z $query ]]; then
    [[ $CRMNE_FILES_PREFIX == / ]] || printf '%s\n' "$CRMNE_FILES_PREFIX"
    children --type d --type f --type l --no-ignore | head -n "$LIST_LIMIT" |
      gawk '{ print ENVIRON["CRMNE_FILES_PREFIX"] $0 }'
  else
    children --type d --type f --type l --no-ignore "${hidden[@]}" | filter | head -n "$LIMIT" |
      gawk 'BEGIN { n = ENVIRON["CRMNE_FILES_NAME"]; p = ENVIRON["CRMNE_FILES_PREFIX"] }
        $0 == n || $0 == n "/" { print p $0; next }
        { rest[++count] = $0 }
        END { for (i = 1; i <= count; i++) print p rest[i] }'
  fi
}

desktop_file() {
  local id=$1 dir
  local dirs=("${XDG_DATA_HOME:-$HOME/.local/share}")
  IFS=: read -ra more <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  dirs+=("${more[@]}")
  for dir in "${dirs[@]}"; do
    [[ -f $dir/applications/$id ]] && { printf '%s\n' "$dir/applications/$id"; return 0; }
  done
  return 1
}

apps() {
  local path=${CRMNE_FILES_PATH:?CRMNE_FILES_PATH} mime="" default id file name icon hidden
  # What xdg-mime query filetype runs here, reading the file on stdin so its
  # name stays off file's command line. Only regular files are read: opening
  # a pipe would wait forever, and nothing opens one anyway.
  if [[ -d $path ]]; then
    mime=inode/directory
  elif [[ -f $path ]]; then
    mime=$(file --brief --mime-type - <"$path" 2>/dev/null)
  fi
  [[ -n $mime ]] || exit 0
  default=$(xdg-mime query default "$mime" 2>/dev/null)

  local seen=" "
  while IFS= read -r id; do
    [[ $seen == *" $id "* ]] && continue
    seen+="$id "
    file=$(desktop_file "$id") || continue
    # The first Name and Icon of the [Desktop Entry] group, before any action.
    IFS=$'\037' read -r name icon hidden < <(gawk '
      /^\[/ { group = $0; next }
      group != "[Desktop Entry]" { next }
      /^Name=/ && name == "" { name = substr($0, 6) }
      /^Icon=/ && icon == "" { icon = substr($0, 6) }
      /^(Hidden|NoDisplay)=true/ { hidden = 1 }
      END { gsub(/[\t\037]/, " ", name); printf "%s\037%s\037%d\n", name, icon, hidden }' "$file")
    [[ $hidden == 1 || -z $name ]] && continue
    printf '%s\t%s\t%s\t%s\n' "$id" "$name" "$icon" "$([[ $id == "$default" ]] && echo 1 || echo 0)"
  done < <({ [[ -n $default ]] && printf '%s\n' "$default"; gio mime "$mime" 2>/dev/null | gawk '/^\t/ { sub(/^\t/, ""); print }'; })
}

case "${1:-}" in
  index) build_index "${2:-}" ;;
  search) search ;;
  list) list ;;
  browse) browse ;;
  apps) apps ;;
  *)
    echo "Usage: crmne-files [--root DIR] index [max-age] | search | list | browse | apps" >&2
    exit 2
    ;;
esac
